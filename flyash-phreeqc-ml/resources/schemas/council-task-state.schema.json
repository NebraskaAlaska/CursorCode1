{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wpi.example/schemas/council-task-state.schema.json",
  "title": "WPI Council task state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_slug", "task_id", "request", "request_hash",
    "base_commit", "state", "revision", "worker_id", "lock", "transitions",
    "evidence", "approvals", "task_branch", "final_task_commit", "updated_at",
    "operator_version", "failure", "correction_round"
  ],
  "properties": {
    "schema_version": {"const": "wpi-council-task-state/v1"},
    "project_slug": {"type": "string"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
    "request": {"$ref": "council-task-request.schema.json"},
    "request_hash": {"$ref": "#/$defs/hash"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "state": {"enum": [
      "draft", "submitted", "claimed", "routing", "planning", "coding", "coder_gate",
      "testing", "tester_gate", "reviewing", "correction_required", "automatic_gates_passed",
      "task_branch_pushed", "awaiting_human_review", "approved", "rejected", "expired",
      "failed", "cancelled"
    ]},
    "revision": {"type": "integer", "minimum": 1},
    "worker_id": {"type": ["string", "null"]},
    "lock": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["task_id", "request_hash", "base_commit", "worker_id", "acquired_at", "heartbeat_at", "lease_expires_at", "operator_version", "state_revision"],
          "properties": {
            "task_id": {"type": "string"}, "request_hash": {"$ref": "#/$defs/hash"},
            "base_commit": {"type": "string"}, "worker_id": {"type": "string"},
            "acquired_at": {"type": "string", "format": "date-time"},
            "heartbeat_at": {"type": "string", "format": "date-time"},
            "lease_expires_at": {"type": "string", "format": "date-time"},
            "operator_version": {"type": "string"}, "state_revision": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "transitions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sequence", "from", "to", "event", "actor", "at", "detail"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "from": {"type": "string"}, "to": {"type": "string"},
          "event": {"type": "string"}, "actor": {"type": "string"},
          "at": {"type": "string", "format": "date-time"}, "detail": {"type": "string"}
        }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["attempts", "summary", "retained_failed_attempts"],
      "properties": {
        "attempts": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["attempt_id", "passed", "correction_kind", "correction_detail", "route", "changed_paths", "patch_hash", "test_evidence_hash", "reviewer_report_hash", "reviewer_verdict", "evidence"],
            "properties": {
              "attempt_id": {"type": "string", "pattern": "^attempt-[0-9]{2}$"},
              "passed": {"type": "boolean"}, "correction_kind": {"type": ["string", "null"]},
              "correction_detail": {"type": "string"}, "route": {"type": "object"},
              "changed_paths": {"type": "array", "items": {"type": "string"}},
              "patch_hash": {"type": "string"}, "test_evidence_hash": {"type": "string"},
              "reviewer_report_hash": {"type": "string"}, "reviewer_verdict": {"type": "string"},
              "evidence": {"type": "object"}
            }
          }
        },
        "summary": {"type": "object"},
        "retained_failed_attempts": {"type": "array", "items": {"type": "string", "pattern": "^attempt-[0-9]{2}$"}}
      }
    },
    "approvals": {"type": "array", "items": {"$ref": "council-approval.schema.json"}},
    "task_branch": {"type": ["string", "null"]},
    "final_task_commit": {"type": ["string", "null"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "operator_version": {"type": "string"},
    "failure": {"type": ["string", "null"]},
    "correction_round": {"type": "integer", "minimum": 0}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
