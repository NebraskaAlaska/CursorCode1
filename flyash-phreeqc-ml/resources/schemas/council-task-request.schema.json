{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wpi.example/schemas/council-task-request.schema.json",
  "title": "WPI Council task request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "revision", "task_id", "title", "goal", "background",
    "repository", "base_branch", "base_commit", "allowed_paths", "forbidden_paths",
    "acceptance_criteria", "required_test_commands", "scientific_risk",
    "security_privacy", "permitted_external_resources", "max_correction_rounds",
    "max_duration_seconds", "max_changed_files", "max_patch_bytes", "requested_backend",
    "requester_identity", "created_at", "canonical_request_hash", "issue_references",
    "review_notes", "relevant_documentation", "resource_update_request_reference"
  ],
  "properties": {
    "schema_version": {"const": "wpi-council-task-request/v1"},
    "revision": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "goal": {"type": "string", "minLength": 1, "maxLength": 16384},
    "background": {"type": "string", "minLength": 1, "maxLength": 32768},
    "repository": {"type": "string", "minLength": 1},
    "base_branch": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "allowed_paths": {"$ref": "#/$defs/nonemptyStrings"},
    "forbidden_paths": {"$ref": "#/$defs/strings"},
    "acceptance_criteria": {"$ref": "#/$defs/nonemptyStrings"},
    "required_test_commands": {
      "type": "array", "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    },
    "scientific_risk": {"enum": ["low", "moderate", "high", "critical"]},
    "security_privacy": {"enum": ["public", "sanitized", "private", "confidential"]},
    "permitted_external_resources": {"$ref": "#/$defs/strings"},
    "max_correction_rounds": {"type": "integer", "minimum": 0},
    "max_duration_seconds": {"type": "integer", "minimum": 60},
    "max_changed_files": {"type": "integer", "minimum": 1},
    "max_patch_bytes": {"type": "integer", "minimum": 1},
    "requested_backend": {"enum": ["hermes", "command", "fake"]},
    "requester_identity": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "canonical_request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issue_references": {"$ref": "#/$defs/strings"},
    "review_notes": {"type": "string"},
    "relevant_documentation": {"$ref": "#/$defs/strings"},
    "resource_update_request_reference": {"type": "string"}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nonemptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
