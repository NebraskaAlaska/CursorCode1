#!/usr/bin/env bash
# Install from the Git root with:
#   cp flyash-phreeqc-ml/scripts/hooks/pre-commit .git/hooks/pre-commit
# The hook and CI deliberately call one fail-closed scanner implementation.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
exec python3 "$repo_root/flyash-phreeqc-ml/scripts/release_scan.py" \
  --staged --docker-context
