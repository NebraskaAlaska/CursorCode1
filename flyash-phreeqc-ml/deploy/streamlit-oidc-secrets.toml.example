# Copy outside the repository, replace every value through an approved secret
# workflow, and mount with VLAB_STREAMLIT_SECRETS_FILE. Never commit the copy.
[auth]
redirect_uri = "https://virtual-lab.example.edu/oauth2callback"
cookie_secret = "GENERATE_A_LONG_RANDOM_SECRET_OUTSIDE_GIT"
client_id = "OIDC_CLIENT_ID_FROM_PROVIDER"
client_secret = "OIDC_CLIENT_SECRET_FROM_PROVIDER"
server_metadata_url = "https://identity.example.edu/.well-known/openid-configuration"
