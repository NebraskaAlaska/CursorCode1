# Version-control and local tooling
.git
.github
.idea
.vscode
.DS_Store
**/.DS_Store
.pytest_cache
.mypy_cache
.ruff_cache
.venv
venv
env
__pycache__
**/__pycache__
*.py[cod]
*.egg-info
build
dist
node_modules

# Secrets, credentials, authentication files, and private TLS material
.env
*.env
.streamlit/secrets.toml
**/secrets.toml
*.pem
*.key
*.p12
*.pfx
deploy/auth
deploy/tls

# Every local/user workspace is excluded from the Docker context, even when
# Git already ignores it. This prevents COPY instructions from baking local
# records into an image.
outputs
experiments/*
!experiments/README.md
data/processed
reports
backups
resources/installed
resources/downloads
resources/candidates
resources/active
databases
models

# Raw or confidential research data are excluded from every image target.
# The approved blank header-only template lives under release/templates.
data/raw

# Binary scientific resources are acquired only by the checksum-pinned builder.
*.dat
*.tar
*.tar.gz
*.tgz
*.zip
*.joblib
*.pkl
*.pickle
*.onnx
*.pt
*.pth
*.bin

# Generated review material and logs never belong to an image.
*.log
screenshots
WPI_Phase_4_Review
